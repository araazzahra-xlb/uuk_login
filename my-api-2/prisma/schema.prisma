generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  CUSTOMER
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
}

enum BillingStatus {
  UNPAID
  WAITING_VERIFICATION
  PAID
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id         String   @id @default(uuid()) @db.VarChar(36)
  name       String   @db.VarChar(100)
  email      String   @unique @db.VarChar(150)
  password   String   @db.VarChar(255)
  role       Role     @default(CUSTOMER)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  subscriptions        Subscription[]
  verified_payments    Payment[]            @relation("PaymentVerifier")

  @@map("users")
}

model ServiceProvider {
  id              String    @id @default(uuid()) @db.VarChar(36)  
  name            String    @db.VarChar(100)
  description     String?   @db.Text
  speed           Int 
  price_per_month Decimal  @db.Decimal(12, 2)
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  subscriptions        Subscription[]

    @@map("service_providers")
}

model Subscription {
  id                     String             @id @default(uuid()) @db.VarChar(36)
  user_id                String             @db.VarChar(36)
  service_provider_id    String             @db.VarChar(36)
  status                 SubscriptionStatus @default(ACTIVE)
  registered_at          DateTime           @default(now())
  created_at             DateTime           @default(now())
  updated_at             DateTime           @updatedAt

  user             User            @relation(fields: [user_id], references: [id], onDelete: Restrict)
  service_provider ServiceProvider @relation(fields: [service_provider_id], references: [id], onDelete: Restrict)
  billings         Billing[]

  @@map("subscriptions")
}

model Billing {
  id              String                 @id @default(uuid()) @db.VarChar(36)
  subscription_id       String
  period_month          Int
  period_year           Int
  amount                Decimal          @db.Decimal(12, 2)
  due_date              DateTime         @db.Date
  status                BillingStatus    @default(UNPAID)
  created_at            DateTime         @default(now())
  updated_at            DateTime         @updatedAt

  subscription Subscription @relation(fields: [subscription_id], references: [id], onDelete: Restrict)
  payment      Payment?

  @@unique([subscription_id, period_month, period_year])
  @@map("billings")
}

model Payment {
  id            String        @id @default(uuid()) @db.VarChar(36)
  billing_id    String        @unique @db.VarChar(36)
  payment_proof String        @db.VarChar(255)
  status        PaymentStatus @default(PENDING)
  verified_by   String?       @db.VarChar(36)
  verified_at   DateTime?
  created_at    DateTime      @default(now())
  updated_at    DateTime      @updatedAt

  billing  Billing @relation(fields: [billing_id], references: [id], onDelete: Restrict)
  verifier User?   @relation("PaymentVerifier", fields: [verified_by], references: [id], onDelete: SetNull)

  @@map("payments")
}
